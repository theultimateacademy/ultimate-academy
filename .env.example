# ─── Supabase ────────────────────────────────────────────────────────────────
# Frontend (exposed to browser — anon key only)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxx

# Backend (server-side only — service key has full DB access)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_xxx

# ─── Stripe ──────────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx

# ─── Strava ──────────────────────────────────────────────────────────────────
STRAVA_CLIENT_ID=123456
STRAVA_CLIENT_SECRET=xxx
# Dev: http://localhost:3001/auth/strava/callback
# Prod: https://<railway-url>/auth/strava/callback
STRAVA_REDIRECT_URI=http://localhost:3001/auth/strava/callback

# ─── Suunto ──────────────────────────────────────────────────────────────────
SUUNTO_CLIENT_ID=xxx
SUUNTO_CLIENT_SECRET=xxx
# Dev: http://localhost:3001/auth/suunto/callback
# Prod: https://<railway-url>/auth/suunto/callback
SUUNTO_REDIRECT_URI=http://localhost:3001/auth/suunto/callback

# ─── Garmin ──────────────────────────────────────────────────────────────────
GARMIN_CLIENT_ID=xxx
GARMIN_CLIENT_SECRET=xxx
# Dev: http://localhost:3001/auth/garmin/callback
# Prod: https://<railway-url>/auth/garmin/callback
GARMIN_REDIRECT_URI=http://localhost:3001/auth/garmin/callback

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
# Dev: http://localhost:3000
# Prod (Railway): https://theultimateacademy.fr
CLIENT_URL=http://localhost:3000

# Dev: http://localhost:3001
# Prod (Vercel env var): https://<your-railway-url>.up.railway.app
VITE_API_URL=http://localhost:3001
